<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ governs cloud backup and device-to-device transfer through this file
  (allowBackup="false" only covers the legacy auto-backup path).
  We deny BOTH paths so nothing leaves the device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
